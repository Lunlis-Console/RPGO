<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LostAndDivine.ClientMonoGame</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <MonoGamePlatform>DesktopGL</MonoGamePlatform>
    <MGCBTool>$(USERPROFILE)\.dotnet\tools\mgcb.exe</MGCBTool>
    <ContentRootDir>$(MSBuildProjectDirectory)\Content</ContentRootDir>
    <ContentOutputDir>$(MSBuildProjectDirectory)\Content\bin\$(MonoGamePlatform)\Content</ContentOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="Myra" Version="1.5.*" />
    <PackageReference Include="System.Drawing.Common" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LostAndDivine.Shared\LostAndDivine.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Content\Sprites\**\*.*" />
    <EmbeddedResource Include="Content\Tilesets\**\*.*" />
    <EmbeddedResource Include="Content\*.tmj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Content\bin\$(MonoGamePlatform)\Content\**\*.*" Exclude="Content\bin\$(MonoGamePlatform)\Content\**\*.mgcb">
      <Link>Content\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="Content\Animations\**\*.*" Exclude="Content\Animations\**\*.mgcb">
      <Link>Content\Animations\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Content\Sprites\**\*.*">
      <Link>Content\Sprites\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Content\Sprites\SpriteSheets\*.png" Condition="Exists('Content\Sprites\SpriteSheets')">
      <Link>Content\Sprites\SpriteSheets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Content\animations.json" Condition="Exists('Content\animations.json')">
      <Link>Content\animations.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Content\*.tmj">
      <Link>Content\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="BuildGameContent" BeforeTargets="BeforeCompile" Condition="Exists('$(MGCBTool)')">
    <Exec Command="&quot;$(MGCBTool)&quot; /quiet /@:&quot;$(ContentRootDir)\Content.mgcb&quot; /platform:$(MonoGamePlatform) /outputDir:&quot;$(ContentOutputDir)&quot; /intermediateDir:&quot;$(ContentRootDir)\obj\$(MonoGamePlatform)\Content&quot; /workingDir:&quot;$(ContentRootDir)&quot;" />
    <ItemGroup>
      <MGCBContent Include="$(ContentOutputDir)\**\*.*" Exclude="$(ContentOutputDir)\**\*.mgcb" />
      <None Include="@(MGCBContent)">
        <Link>Content\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
  </Target>

</Project>
