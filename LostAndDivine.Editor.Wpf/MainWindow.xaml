<Window x:Class="LostAndDivine.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LostAndDivine.Editor.Views"
        Title="Редактор LostAndDivine"
        Width="1280" Height="760"
        MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="Tabs" Grid.Row="0" Margin="4">
            <TabItem Header="Предметы">
                <views:ItemsTabView x:Name="ItemsTab"/>
            </TabItem>
            <TabItem Header="Монстры">
                <views:MonstersTabView x:Name="MonstersTab"/>
            </TabItem>
            <TabItem Header="Квесты">
                <views:QuestsTabView x:Name="QuestsTab"/>
            </TabItem>
            <TabItem Header="НПС">
                <views:NpcsTabView x:Name="NpcsTab"/>
            </TabItem>
            <TabItem Header="Торговцы">
                <views:MerchantsTabView x:Name="MerchantsTab"/>
            </TabItem>
            <TabItem Header="Анимации">
                <views:AnimationsTabView x:Name="AnimationsTab"/>
            </TabItem>
            <TabItem Header="Аккаунты">
                <views:AccountsTabView x:Name="AccountsTab"/>
            </TabItem>
        </TabControl>
        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готово"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>