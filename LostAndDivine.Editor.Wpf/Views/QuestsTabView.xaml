<UserControl x:Class="LostAndDivine.Editor.Views.QuestsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="4">
            <TextBox x:Name="Search" Width="240" VerticalContentAlignment="Center"/>
            <Button x:Name="AddBtn" Content="Добавить" Margin="10,0,6,0" Padding="10,3"/>
            <Button x:Name="DeleteBtn" Content="Удалить" Margin="0,0,6,0" Padding="10,3"/>
            <Button x:Name="EditBtn" Content="Редактировать..." Margin="0,0,6,0" Padding="10,3"/>
            <Button x:Name="SaveBtn" Content="Сохранить квесты" Margin="20,0,0,0" Padding="10,3" FontWeight="Bold"/>
        </StackPanel>
        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  RowHeaderWidth="0"/>
        <TextBlock x:Name="Hint" Grid.Row="2" Margin="4,2" Foreground="Gray"
                   Text="Двойной клик — полный редактор. Цели: если поле «Цели (JSON)» пустое, при сохранении строится одиночная цель из полей редакора."/>
    </Grid>
</UserControl>