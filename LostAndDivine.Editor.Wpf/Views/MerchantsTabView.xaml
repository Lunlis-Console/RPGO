<UserControl x:Class="LostAndDivine.Editor.Views.MerchantsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="4">
            <Button x:Name="AssortBtn" Content="Ассортимент выбранного торговца..." Padding="10,3"/>
            <Button x:Name="RefreshBtn" Content="Обновить" Margin="12,0,0,0" Padding="10,3"/>
        </StackPanel>
        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  RowHeaderWidth="0" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="110"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding name}" Width="2*"/>
                <DataGridTextColumn Header="Локация" Binding="{Binding location}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="Hint" Grid.Row="2" Margin="4,2" Foreground="Gray"
                   Text="Список торговцев (NPC типа merchant). Выберите торговца и нажмите «Ассортимент...», чтобы добавить/убрать товары."/>
    </Grid>
</UserControl>