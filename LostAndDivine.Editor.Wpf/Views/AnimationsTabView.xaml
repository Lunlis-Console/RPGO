<UserControl x:Class="LostAndDivine.Editor.Views.AnimationsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="4">
            <Button x:Name="AddBtn" Content="Добавить (выбрать PNG)..." Padding="10,3"/>
            <Button x:Name="DeleteBtn" Content="Удалить" Margin="12,0,0,0" Padding="10,3"/>
            <Button x:Name="SaveBtn" Content="Сохранить анимации" Margin="12,0,0,0" Padding="10,3" FontWeight="Bold"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="Grid" AutoGenerateColumns="False"
                      CanUserAddRows="True" CanUserDeleteRows="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="All"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ключ" Binding="{Binding Key}" Width="*"/>
                    <DataGridTextColumn Header="Файл" Binding="{Binding Sheet, Mode=OneWay}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Колонки" Binding="{Binding Cols}" Width="70"/>
                    <DataGridTextColumn Header="Строки" Binding="{Binding Rows}" Width="70"/>
                    <DataGridTextColumn Header="FPS" Binding="{Binding Fps}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Background="#14161C" BorderBrush="Gray" BorderThickness="1,0,0,0">
                <Image x:Name="Preview" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
        </Grid>
        <TextBlock x:Name="Hint" Grid.Row="2" Margin="4,2" Foreground="Gray"
                   Text="Превью анимации выбранной строки. Ключ = имя файла без расширения. Сохранение пишет animations.json в bin и src контента клиента и копирует PNG."/>
    </Grid>
</UserControl>