<Window x:Class="LostAndDivine.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LostAndDivine — Лаунчер"
        Width="720" Height="560"
        MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#1b1d2a" Foreground="#e8e8f0">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="LostAndDivine" FontSize="28" FontWeight="Bold" Foreground="#c9a76b"/>
            <TextBlock x:Name="VersionLabel" Text="" FontSize="14" Foreground="#8a8ca6" VerticalAlignment="Bottom" Margin="12,0,0,4"/>
        </StackPanel>

        <!-- Сервер + действия -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Сервер:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="ServerIpBox" Width="160" Height="26" VerticalContentAlignment="Center"
                     Background="#262a3d" Foreground="#e8e8f0" BorderBrush="#3a3f5c"/>
            <Button x:Name="SaveIpButton" Content="Сохранить" Width="78" Height="26" Margin="6,0,0,0"
                    Background="#3a3f5c" Foreground="#e8e8f0" BorderThickness="0"/>
            <Button x:Name="CheckButton" Content="Проверить обновления" Width="180" Height="30" Margin="16,0,0,0"
                    Background="#c9a76b" Foreground="#1b1d2a" FontWeight="Bold" BorderThickness="0"/>
            <Button x:Name="PlayButton" Content="Играть" Width="120" Height="30" Margin="8,0,0,0"
                    Background="#5aa469" Foreground="#10130f" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>

        <!-- История изменений -->
        <GroupBox Grid.Row="2" Header="Что нового" Foreground="#c9a76b" BorderBrush="#3a3f5c">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChangelogList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#e8e8f0" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding Lines}" Margin="12,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#b9bcd6" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <!-- Статус -->
        <TextBlock Grid.Row="3" x:Name="StatusLabel" Text="Готово" Foreground="#8a8ca6" Margin="0,10,0,0"/>
    </Grid>
</Window>
